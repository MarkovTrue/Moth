{
  "permissions": {
    "allow": [
      "__claude-auto-approve__",
      "Bash(*)",
      "Edit(*)",
      "Write(*)",
      "Read(*)",
      "Glob(*)",
      "Grep(*)",
      "WebFetch(*)",
      "WebSearch(*)",
      "TodoWrite(*)",
      "Task(*)",
      "NotebookEdit(*)",
      "Bash(ls -la \"D:\\\\Portable\\\\Obsidian\\\\Base\\\\[Obsidian]\\\\Work\\\\VPN\\\\Commercial VPN\" 2>&1 || echo \"trying alternative\")",
      "Read(//d/Portable/Obsidian/Base/[Obsidian]/Work/VPN/Commercial VPN/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "ExitPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"process.stdout.write(JSON.stringify({decision: 'approve'}))\""
          }
        ]
      },
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"process.stdout.write(JSON.stringify({decision: 'approve', answer: 'yes'}))\""
          }
        ]
      }
    ]
  }
}
