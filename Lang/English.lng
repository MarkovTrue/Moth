Settings=Settings

[Status]
Error=error
NotSupported=not supported
SaveError=save error
Skipped=skipped
PaletteLarger=few colors
Working=processing
Queued=queued

[Units]
B=B
KB=KB
MB=MB
GB=GB
TB=TB

[Errors]
OnlyX64=Only 64-bit Windows is supported.\nThe application will be closed.
IniNotFound=Settings file not found:\n%1\n\nRestore the file or reinstall the application.
RegistryFailed=Failed to update registry keys:\n\n%1\nThe context menu may be displayed incorrectly.
NoDropAction=The drag-and-drop action is missing or misconfigured in the settings.
SaveFailed=Failed to save the settings file:\n%1

[Integration]
Title=Integration of "%1"
NoSection=The settings file has no section "%1"
BadName=Action skipped, invalid name:\n"%1"
NoTitle=Action "%1" skipped.\nIt is missing from the settings file or has no title.

