; Moth – русский язык
; \n – перевод строки, %1 – место для подстановки

[Main]
ColFile=Файл
ColBefore=Было
ColAfter=Стало
ColSaved=Экономия
ColTask=Задача
ShowInExplorer=Показать в проводнике
CopyAsPath=Копировать как путь
Progress=В работе
Complete=Готово
Saved=Сжатие
ErrorsOne=%1 ошибка
ErrorsFew=%1 ошибки
ErrorsMany=%1 ошибок
Settings=Настройки

[Status]
Error=ошибка
NotSupported=не поддерживается
SaveError=ошибка сохранения
Skipped=пропуск
PaletteLarger=мало цветов
Working=в работе
Queued=в очереди

[Units]
B=Б
KB=КБ
MB=МБ
GB=ГБ
TB=ТБ

[Errors]
OnlyX64=Поддерживаются только 64-битные ОС.\nПриложение будет закрыто.
IniNotFound=Не найден файл настроек:\n%1\n\nВосстановите файл или переустановите приложение.
RegistryFailed=Не удалось обновить ключи реестра:\n\n%1\nКонтекстное меню может отображаться некорректно.
NoDropAction=Действие при перетаскивании отсутствует в настройках или настроено некорректно.
SaveFailed=Не удалось сохранить файл настроек:\n%1

[Integration]
Title=Интеграция формата "%1"
NoSection=В файле настроек нет секции "%1"
BadName=Действие пропущено, недопустимое название:\n"%1"
NoTitle=Действие "%1" пропущено.\nЕго нет в файле настроек, либо у него нет заголовка.

[Settings]
Language=Язык
Theme=Тема
ThemeLight=Светлая
ThemeDark=Тёмная
Integrate=Добавить в контекстное меню проводника
Folders=Показывать в меню для папок
TopPosition=Показывать Moth вверху списка
; В фигурных скобках - клавиши, рисуются кнопками
Extended=Показывать только по {SHIFT} + Правый клик
OpenIni=Moth.ini
OpenIniTip=Открыть файл настроек: состав меню, названия и параметры действий
GitHubTip=Moth на GitHub: описание и релизы
OK=ОК
Cancel=Отмена
AutoClose=Автозакрытие
AutoCloseOff=Выкл
AutoCloseTip=Через сколько секунд после обработки закрыть окно Moth. Клик по окну отменяет закрытие
Seconds=с
Updates=Обновления
UpdatesOn=Проверять
UpdatesOff=Не проверять
UpdatesTip=Раз в неделю один запрос к релизам на GitHub, ничего не скачивается
CheckNow=Проверить сейчас

[Updates]
TitleUpdate=[доступно обновление]
Available=Доступна версия %1
