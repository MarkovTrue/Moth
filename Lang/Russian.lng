; Moth – русский язык
; \n – перевод строки, %1 – место для подстановки

[Main]
ColFile=Файл
ColSize=Размер
ColNew=Новый
ColPercent=Процент
ColSaved=Сжатие
ColTask=Задача
ShowInExplorer=Показать в проводнике
CopyAsPath=Копировать как путь
Progress=Прогресс
Complete=Завершено
Saved=Сжатие
SizeTotal=Размер
Settings=Настройки

[Status]
Error=ошибка
NotSupported=не поддерживается
SaveError=ошибка сохранения
Skipped=пропуск
PaletteLarger=мало цветов

[Units]
B=Б
KB=КБ
MB=МБ
GB=ГБ
TB=ТБ

[Errors]
OnlyX64=Поддерживаются только 64-битные ОС.\nПриложение будет закрыто.
IniNotFound=Не найден файл настроек:\n%1\n\nВосстановите файл или переустановите приложение.
RegistryFailed=Не удалось обновить ключи реестра:\n\n%1\nКонтекстное меню может отображаться некорректно.
NoDropAction=Действие при перетаскивании отсутствует в настройках или настроено некорректно.
SaveFailed=Не удалось сохранить файл настроек:\n%1

[Integration]
Title=Интеграция формата "%1"
NoSection=В файле настроек нет секции "%1"
BadName=Действие пропущено, недопустимое название:\n"%1"
NoTitle=Действие "%1" пропущено.\nЕго нет в файле настроек, либо у него нет заголовка.

